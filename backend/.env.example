PORT=5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hbedb
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
# Source connection used only by `npm run db:migrate:data`; never used by the API.
# MONGODB_URI=mongodb://localhost:27017/hbe_label
# DATA_MIGRATION_BATCH_SIZE=250
# DATA_MIGRATION_REPORT=./migration-report.json
JWT_SECRET=
JWT_EXPIRE=30d
# Dedicated 32+ character secret used to encrypt Linkup bank details at rest.
# Keep stable and store it in the production secret manager; changing it requires key rotation.
BANK_ACCOUNT_ENCRYPTION_KEY=
# Optional interval for releasing expired unpaid Linkup inventory holds (milliseconds).
LINKUP_HOLD_SWEEP_MS=300000

# HBE Live transactional email (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bookinghbelive@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=HBE Live
SMTP_FROM_EMAIL=bookinghbelive@gmail.com
SYSTEM_NOTIFICATION_EMAIL=bookinghbelive@gmail.com
ADMIN_NOTIFICATION_EMAIL=bookinghbelive@gmail.com
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_QUEUE_INTERVAL_MS=30000
NODE_ENV=production
# Public frontend address used in password-reset links.
FRONTEND_URL=https://hbe.lol
# Comma-separated browser origins permitted by CORS.
CORS_ORIGINS=https://hbe.lol,https://www.hbe.lol
# HTTPS automation endpoint that accepts JSON with email, name, resetUrl and
# expiresInMinutes, then delivers the reset link through your email provider.
# Required for self-service password recovery in production.
# PASSWORD_RESET_WEBHOOK_URL=https://automation.example.com/hbe-password-reset
# Development/demo only: expose the one-time reset token in the UI.
# PASSWORD_RESET_EXPOSE_TOKEN=false
# Development-only credential used by npm-run demo seeding. Do not set in production.
# DEMO_PASSWORD=
# Required for verified three-copy backups. CLOUD_BACKUP_PATH should point to a
# locally mounted cloud-sync folder (OneDrive, Dropbox, Google Drive, etc.).
# EXTERNAL_BACKUP_PATH should point to a connected external drive folder.
# CLOUD_BACKUP_PATH=D:\OneDrive\HBE-Backup
# EXTERNAL_BACKUP_PATH=E:\HBE-Backup
# Distribeats Tenant API credentials are server-side only.
# Use a test key (db_test_...) for payload validation or a live key (db_live_...) for real catalogue.
DISTRIBEATS_API_KEY=
# Production: https://distribeats.com/api/public/v1
DISTRIBEATS_BASE_URL=https://distribeats.com/api/public/v1
# Registered label name in your Distribeats account Settings (omit to use your saved workspace label name).
DISTRIBEATS_LABEL_NAME=
# Signing secret from your Distribeats workspace Developer & API webhook endpoint.
DISTRIBEATS_WEBHOOK_SECRET=
# Webhook-first fallback sync: sweep every 15 minutes, poll only records stale for 30 minutes,
# and cap each sweep at 100 provider requests to prevent traffic spikes on large catalogues.
DISTRIBEATS_SYNC_SWEEP_MS=900000
DISTRIBEATS_SYNC_STALE_MS=1800000
DISTRIBEATS_SYNC_BATCH_SIZE=100
# Public backend origin used to display the webhook endpoint in Admin Settings.
# Example: https://api.your-label.com
PUBLIC_API_URL=https://api.hbe.lol

# This value is embedded in the public browser bundle. Never put secrets here.
VITE_API_URL=/api
# Public OAuth client identifier used by Google Identity Services.
VITE_GOOGLE_CLIENT_ID=
# Optional when /socket.io is proxied on the same host. Set this when the API
# and frontend use separate domains, for example https://api.example.com.
VITE_SOCKET_URL=
